restaurant_id     INT          NOT NULL,
restaurant_name   VARCHAR(100) NOT NULL DEFAULT '',
city              VARCHAR(100) NOT NULL DEFAULT '',
state             CHAR(2)      NOT NULL DEFAULT '',
has_table_service TINYINT(1)   NOT NULL DEFAULT 1,
